@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <!-- Het verplichte gele vlak volgens de school richtlijnen -->
    <div class="alert alert-warning shadow-sm border-warning mb-4" role="alert">
        <h4 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Belangrijke Mededeling</h4>
        <p class="mb-0">Let op: Zorg ervoor dat alle gepickte orders tijdig worden afgemeld. Controleer aan het eind van de dag de voorraadverschillen.</p>
    </div>

    <h2 class="mb-4">Overzicht</h2>

    <div class="row g-4">
        <!-- Vierkant 1: Te picken orders -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center p-5">
                    <i class="bi bi-clipboard-check display-3 text-primary mb-3"></i>
                    <h4 class="card-title fw-bold">Te Picken Orders</h4>
                    <p class="card-text text-muted">Verzamel de producten voor openstaande bestellingen.</p>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-primary mt-3 w-100">Ga naar werklijst</a>
                </div>
            </div>
        </div>

        <!-- Vierkant 2: Klachten -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-danger">
                <div class="card-body text-center p-5">
                    <i class="bi bi-star display-3 text-danger mb-3"></i>
                    <h4 class="card-title fw-bold">Klachten</h4>
                    <p class="card-text text-muted">Bekijk en behandel de binnengekomen klantklachten.</p>
                    <a asp-controller="Klachten" asp-action="Index" class="btn btn-outline-danger mt-3 w-100">Beheer klachten</a>
                </div>
            </div>
        </div>

        <!-- Vierkant 3: Lage voorraad -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-warning">
                <div class="card-body text-center p-5">
                    <i class="bi bi-boxes display-3 text-warning mb-3"></i>
                    <h4 class="card-title fw-bold">Lage Voorraad</h4>
                    <p class="card-text text-muted">Controleer producten die onder de minimumvoorraad zitten.</p>
                    <a asp-controller="VoorraadBeheer" asp-action="Index" class="btn btn-outline-warning mt-3 w-100 text-dark">Beheer voorraad</a>
                </div>
            </div>
        </div>
    </div>
</div>