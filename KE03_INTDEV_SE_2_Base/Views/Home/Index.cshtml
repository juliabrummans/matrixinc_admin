    @{
    ViewData["Title"] = "Dashboard - Matrix Inc.";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4 fw-bold">Dashboard</h1>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/52/Red_and_blue_pill.jpg"
                     class="card-img-top img-fluid rounded"
                     alt="Dashboard Afbeelding"
                     style="object-fit: cover; max-height: 350px; width: 100%;">
            </div>
        </div>
    </div>

    <div class="row">
        
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">Acties</div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <a asp-controller="Customers" asp-action="Index" class="btn btn-primary mb-3">Naar Klantenbeheer</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Producten Beheren</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">Systeemstatus</div>
                <div class="card-body">
                    <p class="mb-2"><strong>Actieve klanten:</strong> 84</p>
                    <p class="mb-2"><strong>Openstaande orders:</strong> 12</p>
                    <p class="mb-0 text-success fw-bold">Systeem online</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-info h-100">
                <div class="card-header bg-info text-white fw-bold">
                    Actueel Weer (Heerlen)
                </div>
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h3 id="weather-temp" class="fw-bold mb-1">Laden...</h3>
                    <p id="weather-desc" class="text-muted small mb-2"></p>
                    <span id="weather-rain" class="badge bg-primary mx-auto"></span>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const apiUrl = 'https://api.open-meteo.com/v1/forecast?latitude=50.8882&longitude=5.9805&current=temperature_2m,wind_speed_10m,precipitation';

            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    const temp = data.current.temperature_2m;
                    const wind = data.current.wind_speed_10m;
                    const rain = data.current.precipitation;
                    
                    document.getElementById('weather-temp').innerText = temp + ' °C';
                    document.getElementById('weather-desc').innerText = 'Windsnelheid: ' + wind + ' km/u';
                    document.getElementById('weather-rain').innerText = 'Regenval: ' + rain + ' mm';
                })
                .catch(error => {
                    document.getElementById('weather-temp').innerText = 'N/A';
                    document.getElementById('weather-desc').innerText = 'Weergegevens tijdelijk niet beschikbaar';
                });
        });
    </script>
}