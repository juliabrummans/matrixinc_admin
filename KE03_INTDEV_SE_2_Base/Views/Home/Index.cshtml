@{
    ViewData["Title"] = "Dashboard - Matrix Inc.";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4 fw-bold">Dashboard</h1>

    <div class="position-relative mb-5 shadow-sm rounded overflow-hidden" style="max-height: 350px;">
        
        <img src="https://www.kaartje2go.nl/kaart-maken/kies-je-kleur-geel-ansichtkaart/img/kies-je-kleur-geel-ansichtkaart.jpeg"
             class="img-fluid w-100"
             alt="Dashboard Banner"
             style="object-fit: cover; height: 350px;">

        <div class="position-absolute top-50 start-50 translate-middle w-100 px-4">
            <div class="row justify-content-center g-3">
                
                <div class="col-6 col-md-3">
                    <div class="card border-0 text-center shadow" style="background-color: rgba(255, 255, 255, 0.95); min-height: 110px;">
                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="stretched-link"></a>
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                            <span class="text-muted small fw-bold text-uppercase">Openstaande Orders</span>
                            <h3 class="fw-bold text-dark m-0 mt-1">12</h3>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card border-0 text-center shadow" style="background-color: rgba(255, 255, 255, 0.95); min-height: 110px;">
                        <a asp-controller="Klachten"
                           asp-action="Index"
                           class="stretched-link"></a>
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                            <span class="text-muted small fw-bold text-uppercase">Klachten</span>
                            <h3 class="fw-bold text-danger m-0 mt-1">2</h3>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card border-0 text-center shadow" style="background-color: rgba(255, 255, 255, 0.95); min-height: 110px;">
                        <a asp-controller="Bezorgers"
                           asp-action="Index"
                           class="stretched-link"></a>
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                            <span class="text-muted small fw-bold text-uppercase">Actieve Bezorgers</span>
                            <h3 class="fw-bold text-success m-0 mt-1">7</h3>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row">
        
        <div class="col-lg-9 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold border-bottom-0 pt-3">
                    Nieuwste binnengekomen orders
                </div>
                <a asp-controller="Orders"
                   asp-action="Index"
                   class="stretched-link"></a>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Ordernummer</th>
                                    <th>Klant</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-3">#1084</td>
                                    <td>Neo</td>
                                    <td>
                                        <span class="d-inline-block bg-success rounded-circle me-2" style="width: 10px; height: 10px;"></span>Afgehandeld
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">#1085</td>
                                    <td>Morpheus</td>
                                    <td>
                                        <span class="d-inline-block bg-warning rounded-circle me-2" style="width: 10px; height: 10px;"></span>In verwerking
                                    </td>
                                </tr>
                                <tr>
                                    <td class="ps-3">#1086</td>
                                    <td>Trinity</td>
                                    <td>
                                        <span class="d-inline-block bg-warning rounded-circle me-2" style="width: 10px; height: 10px;"></span>In verwerking
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-info h-100">
                <div class="card-header bg-info text-white fw-bold">
                    Actueel Weer (Heerlen)
                </div>
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h3 id="weather-temp" class="fw-bold mb-1">Laden...</h3>
                    <p id="weather-desc" class="text-muted small mb-2"></p>
                    <span id="weather-rain" class="badge bg-primary mx-auto"></span>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const apiUrl = 'https://api.open-meteo.com/v1/forecast?latitude=50.8882&longitude=5.9805&current=temperature_2m,wind_speed_10m,precipitation';

            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    const temp = data.current.temperature_2m;
                    const wind = data.current.wind_speed_10m;
                    const rain = data.current.precipitation;
                    
                    document.getElementById('weather-temp').innerText = temp + ' °C';
                    document.getElementById('weather-desc').innerText = 'Windsnelheid: ' + wind + ' km/u';
                    document.getElementById('weather-rain').innerText = 'Regenval: ' + rain + ' mm';
                })
                .catch(error => {
                    document.getElementById('weather-temp').innerText = 'N/A';
                    document.getElementById('weather-desc').innerText = 'Weergegevens tijdelijk niet beschikbaar';
                });
        });
    </script>
}