@{
    ViewData["Title"] = "Create Order";
}

<h1>Nieuwe Bestelling</h1>

<form asp-action="Create">

    <div class="mb-3">
        <label>Bestelling Datum</label>
        <input name="orderDate"
               type="date"
               class="form-control"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3">
        <label>Klant</label>
        <select name="customerId" class="form-control" asp-items="ViewBag.Customers"></select>
    </div>

    <div class="mb-3">
        <label>Product</label>
        <select name="productId" class="form-control" asp-items="ViewBag.Products"></select>
    </div>

    <button type="submit" class="btn btn-primary">Opslaan</button>

</form>