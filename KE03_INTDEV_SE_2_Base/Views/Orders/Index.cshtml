@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Bestellingen</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Maak nieuwe bestelling</a>
</p>

<table class="table table-striped table-hover mt-3 shadow-sm border rounded">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Bestelling datum</th>
            <th>Klant</th>
            <th>Producten</th>
            <th>Acties</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.OrderDate.ToString("dd-MM-yyyy")</td>
            <td>@item.Customer?.Name</td>
            <td>@item.Products.Count</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Bewerken</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm text-white">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Verwijderen</a>
            </td>
        </tr>
    }
    </tbody>
</table>