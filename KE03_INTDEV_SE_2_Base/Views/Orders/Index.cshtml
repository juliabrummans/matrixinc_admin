@model IEnumerable<KE03_INTDEV_SE_2_Base.Models.OrderPickViewModel>

@{
    ViewData["Title"] = "Te Picken Orders";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Te Picken Orders</h2>
        <a asp-action="Historie" class="btn btn-outline-secondary">Bekijk Orderhistorie</a>
    </div>

    <table class="table table-bordered table-striped bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Aantal Regels</th>
                <th>Doel/Krat</th>
                <th>Actie</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td class="fw-bold">#@order.OrderId</td>
                    <td>@order.Items.Count items</td>
                    <td>@order.DropLocation</td>
                    <td>
                        <a asp-controller="Orders" asp-action="PickOrder" asp-route-id="@order.OrderId" class="btn btn-primary btn-sm">
                            Start Picken
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-success fw-bold text-center py-3">Alle orders zijn verwerkt!</td>
                </tr>
            }
        </tbody>
    </table>
</div>