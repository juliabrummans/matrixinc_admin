@model IEnumerable<DataAccessLayer.Models.Product>

@{
    ViewData["Title"] = "Producten";
}

<h1 class="mb-4">Producten</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        Nieuwe Product
    </a>
</p>

<!-- SEARCH + FILTER FORM -->
<form asp-action="Index" method="get" class="mb-4">

    <div class="row g-2 mb-3">

        <!-- SEARCH + AUTOCOMPLETE -->
        <div class="col-md-4 position-relative">

            <input type="text"
                   id="searchBox"
                   name="searchString"
                   class="form-control"
                   placeholder="Zoek product..." />

            <!-- AUTOCOMPLETE LIST -->
            <ul id="suggestions"
                class="list-group position-absolute w-100"
                style="z-index: 1000; max-height: 200px; overflow-y: auto;"></ul>

        </div>

        <!-- MIN PRICE -->
        <div class="col-md-3">
            <input type="number"
                   step="0.01"
                   name="minPrice"
                   class="form-control"
                   placeholder="Min prijs" />
        </div>

        <!-- MAX PRICE -->
        <div class="col-md-3">
            <input type="number"
                   step="0.01"
                   name="maxPrice"
                   class="form-control"
                   placeholder="Max prijs" />
        </div>

        <!-- BUTTONS -->
        <div class="col-md-2 d-flex gap-2">

            <!-- GRAY SEARCH BUTTON -->
            <button class="btn btn-secondary">
                Zoeken
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Reset
            </a>

        </div>

    </div>

</form>

<!-- PRODUCT TABLE -->
<div class="table-responsive">
    <table class="table table-hover table-striped align-middle">

        <thead class="table-dark">
            <tr>
                <th>Naam</th>
                <th>Prijs</th>
                <th>Beschrijving</th>
                <th class="text-center">Acties</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Name</td>

                    <td>€ @item.Price</td>

                    <td style="max-width: 400px;">
                        @item.Description
                    </td>

                    <td class="text-center">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Bewerken
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Verwijderen
                        </a>

                    </td>

                </tr>
            }
        </tbody>

    </table>
</div>

<!-- AUTOCOMPLETE SCRIPT -->
@section Scripts {
    <script>
        const searchBox = document.getElementById("searchBox");
        const suggestions = document.getElementById("suggestions");

        searchBox.addEventListener("input", function () {
            const value = this.value;

            if (!value) {
                suggestions.innerHTML = "";
                return;
            }

            fetch(`/Products/SearchSuggestions?term=${encodeURIComponent(value)}`)
                .then(res => res.json())
                .then(data => {

                    suggestions.innerHTML = "";

                    data.forEach(item => {
                        const li = document.createElement("li");
                        li.className = "list-group-item list-group-item-action";
                        li.style.cursor = "pointer";
                        li.textContent = item;

                        li.addEventListener("click", function () {
                            searchBox.value = item;
                            suggestions.innerHTML = "";
                        });

                        suggestions.appendChild(li);
                    });
                });
        });

        document.addEventListener("click", function (e) {
            if (!searchBox.contains(e.target) && !suggestions.contains(e.target)) {
                suggestions.innerHTML = "";
            }
        });
    </script>
}