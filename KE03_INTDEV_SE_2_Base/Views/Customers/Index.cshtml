@model IEnumerable<DataAccessLayer.Models.Customer>

@{
    // A: Nederlands
    ViewData["Title"] = "Klantenoverzicht";
}

<h1 class="my-4">Klantenoverzicht</h1>

<p>
    <a asp-action="Create" class="btn btn-primary shadow-sm">Nieuwe klant aanmaken</a>
</p>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row align-items-center g-2">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Zoek op naam of adres..." />
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select">
                <option value="">-- Alle bestellingen --</option>
                <option value="Active" selected="@((string)ViewData["CurrentStatusFilter"] == "Active")">Met openstaande bestelling</option>
                <option value="Inactive" selected="@((string)ViewData["CurrentStatusFilter"] == "Inactive")">Zonder openstaande bestelling</option>
            </select>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-secondary">Zoeken</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover mt-3 shadow-sm border rounded">
    <thead class="table-dark">
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-statusFilter="@ViewData["CurrentStatusFilter"]" class="text-white text-decoration-none">
                    Naam ↓↑
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["AddressSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-statusFilter="@ViewData["CurrentStatusFilter"]" class="text-white text-decoration-none">
                    Adres ↓↑
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["OrderSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-statusFilter="@ViewData["CurrentStatusFilter"]" class="text-white text-decoration-none">
                    Openstaande bestelling ↓↑
                </a>
            </th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @if (item.Active)
                    {
                        <span class="badge bg-success">Ja</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Nee</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Bewerken</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Verwijderen</a>
                </td>
            </tr>
        }
    </tbody>
</table>